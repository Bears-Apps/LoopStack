<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TestFlight upload options.

  `destination: upload` is the whole point: it sends the archive straight to
  App Store Connect using Xcode's own signed-in account, with no altool
  credential, no API key, and no app-specific password anywhere. Earlier builds
  stopped at "archived, go press Distribute in Organizer" because that was
  assumed to need a credential this machine did not have. It did not.

  Usage, after `npm run build && npx cap sync ios`:

    xcodebuild archive -project ios/App/App.xcodeproj -scheme App \
      -configuration Release -destination 'generic/platform=iOS' \
      -archivePath /tmp/LoopStack.xcarchive -allowProvisioningUpdates

    xcodebuild -exportArchive -archivePath /tmp/LoopStack.xcarchive \
      -exportOptionsPlist ios/ExportOptions-upload.plist -allowProvisioningUpdates

  One gotcha worth remembering: never leave two archive runs alive against the
  same DerivedData. They race on the same signing targets and fail with
  `errSecInternalComponent`, which looks exactly like a locked keychain and is
  not. Kill every xcodebuild before retrying.

  Swap destination to `export` to produce a local .ipa instead of uploading.
-->
<plist version="1.0">
<dict>
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>L48NRSTM9T</string>
  <key>uploadSymbols</key><true/>
  <key>signingStyle</key><string>automatic</string>
  <key>destination</key><string>upload</string>
</dict>
</plist>
